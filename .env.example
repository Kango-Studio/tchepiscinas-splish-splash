# Copie para .env e preencha. Nunca faça commit do .env.
# Supabase Dashboard > Project Settings > API

# --- Públicas (vão para o navegador) ---------------------------------------
# URL do projeto e chave anon/publishable. São seguras no frontend porque o
# acesso aos leads é bloqueado por RLS (apenas administradores autorizados).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Somente servidor (NUNCA use o prefixo VITE_) ----------------------------
# Usadas pela função de servidor que grava os pedidos do formulário do site.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: texto aleatório usado no hash do IP para o limite de envios.
LEAD_RATE_LIMIT_SALT=
